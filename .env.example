# Copy to .env (gitignored) for tools/smoke/live-openai.sh, the paid check against the real OpenAI API.
# The gateway itself reads OPENAI_API_KEY from the environment, not from this file.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# gateway-app outside the `local` profile needs these two from the environment, 32 to 512 visible ASCII characters
# each and different from each other (`openssl rand -base64 32`). live-openai.sh generates throwaway values.
# LLMGW_KEY_HMAC_SECRET=
# LLMGW_ADMIN_KEY=

# Optional: the model the live check calls.
# LLMGW_LIVE_MODEL=gpt-4o-mini
