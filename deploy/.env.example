# Local stack overrides (FND-02). Copy to deploy/.env (gitignored) and uncomment what you change.
# Compose reads deploy/.env because -f deploy/compose.yaml makes deploy/ the project directory.
# Apps in a worktree change their port with SERVER_PORT on bootRun. Tools read the same variables:
#   set -a; . deploy/.env; set +a
#
# Defaults (the CLAUDE.md port table):
# COMPOSE_PROJECT_NAME=llmgw
# LLMGW_POSTGRES_PORT=5440
# LLMGW_REDIS_PORT=6390
# LLMGW_KAFKA_PORT=19092
# LLMGW_OTLP_GRPC_PORT=4317
# LLMGW_OTLP_HTTP_PORT=4318
# LLMGW_JAEGER_UI_PORT=16686
# LLMGW_PROMETHEUS_PORT=9090
# LLMGW_GRAFANA_PORT=3301
# A documented local-only credential on a loopback port, not a secret.
# LLMGW_POSTGRES_PASSWORD=llmgw
#
# A second worktree: its own project name (containers, network, volumes) and every port +100.
# COMPOSE_PROJECT_NAME=llmgw-wt2
# LLMGW_POSTGRES_PORT=5540
# LLMGW_REDIS_PORT=6490
# LLMGW_KAFKA_PORT=19192
# LLMGW_OTLP_GRPC_PORT=4417
# LLMGW_OTLP_HTTP_PORT=4418
# LLMGW_JAEGER_UI_PORT=16786
# LLMGW_PROMETHEUS_PORT=9190
# LLMGW_GRAFANA_PORT=3401
